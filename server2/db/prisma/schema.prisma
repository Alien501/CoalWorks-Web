// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
  output   = "../../src/utils/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model InitStatus {
  id       Int      @id @default(autoincrement())
  isInit   Boolean  @default(false)
  initData DateTime @default(now())
}

model SuperAdmin {
  id           Int    @id @default(autoincrement())
  name         String @db.VarChar(255)
  email        String @db.VarChar(255)
  passwordHash String @db.VarChar(255)
  salt         String @db.VarChar(255)
}

model Mine {
  mineId             Int       @id @default(autoincrement())
  mineName           String    @db.VarChar(100)
  locationLatitude   Float
  locationLongitude  Float
  address            String    @db.VarChar(255)
  ownerId            Int?
  mineType           String    @db.VarChar(50)
  productionCapacity Decimal   @db.Decimal(10, 2)
  operationalStatus  Boolean   @db.Boolean
  startDate          DateTime  @db.Date
  endDate            DateTime? @db.Date

  owner Owner? @relation(fields: [ownerId], references: [ownerId])

  @@map("mines")
}

model Owner {
  ownerId      Int    @id @default(autoincrement())
  ownerName    String @db.VarChar(100)
  contactName  String @db.VarChar(100)
  contactEmail String @db.VarChar(100)
  contactPhone String @db.VarChar(15)
  mines        Mine[]

  @@map("owners")
}

model Position {
  positionId       Int      @id @default(autoincrement())
  positionName     String   @db.VarChar(100)
  description      String   @db.Text
  isActive         Boolean  @db.Boolean
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  responsibilities Json
  Users            User[]
}

model Role {
  roleId      Int      @id @default(autoincrement())
  roleName    String   @unique @db.VarChar(100)
  description String?  @db.Text
  permissions Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Users       User[]
}

model Permission {
  permissionId Int     @id @default(autoincrement())
  name         String  @unique @db.VarChar(100)
  category     String  @db.VarChar(50)
  description  String? @db.Text
  isActive     Boolean @default(true)
}

model User {
  userId                Int                       @id @default(autoincrement())
  username              String                    @unique @db.VarChar(100)
  email                 String                    @unique @db.VarChar(100)
  phone                 String?                   @db.VarChar(20)
  passwordHash          String                    @db.VarChar(255)
  salt                  String                    @db.VarChar(255)
  userRoleId            Int
  userRole              Role                      @relation(fields: [userRoleId], references: [roleId])
  positionId            Int?
  position              Position?                 @relation(fields: [positionId], references: [positionId])
  isActive              Boolean                   @default(true)
  profileImage          String?                   @db.VarChar(255)
  lastLogin             DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  createdBy             Int?
  creator               User?                     @relation("UserCreation", fields: [createdBy], references: [userId])
  createdUsers          User[]                    @relation("UserCreation")
  supervisor            Supervisor?
  isSupervisor          Boolean                   @default(false)
  activePlans           ActivePlans[]
  supervisorAssignments ShiftAssignment[]         @relation("SupervisorAssignments")
  operatorAssignments   ShiftAssignmentOperator[] @relation("OperatorAssignments")
  shifts                ShiftUsers[]
  sections              SectionUsers[]
  riskAssesmentResponse RiskAssessmentResponse[] 
}

model ShiftAssignment {
  id           Int      @id @default(autoincrement())
  sectionId    Int
  shiftId      Int
  supervisorId Int
  createdAt    DateTime @default(now())

  section    Section @relation(fields: [sectionId], references: [id])
  shift      Shift   @relation(fields: [shiftId], references: [shiftId])
  supervisor User    @relation("SupervisorAssignments", fields: [supervisorId], references: [userId])

  operators ShiftAssignmentOperator[]
}

model ShiftAssignmentOperator {
  id                Int @id @default(autoincrement())
  shiftAssignmentId Int
  operatorId        Int

  shiftAssignment ShiftAssignment @relation(fields: [shiftAssignmentId], references: [id], onDelete: Cascade)
  operator        User            @relation("OperatorAssignments", fields: [operatorId], references: [userId])

  @@unique([shiftAssignmentId, operatorId])
}

model Section {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(255)
  sectionType Int
  area        Int?

  type             SectionType       @relation(fields: [sectionType], references: [id])
  assets           Asset[]
  coordinates      Coordinate[]
  activePlans      ActivePlans[]
  supervisors      Supervisor[]
  users            SectionUsers[] // Many-to-many relation
  shiftAssignments ShiftAssignment[]
  shiftTemplates   ShiftTemplate[]
  RiskAssesment    RiskAssesment[]
}

model Supervisor {
  id        Int     @id @default(autoincrement())
  sectionId Int
  userId    Int     @unique
  section   Section @relation(fields: [sectionId], references: [id])
  user      User    @relation(fields: [userId], references: [userId])
}

model SectionUsers {
  sectionId Int
  userId    Int

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([sectionId, userId])
}

model Shift {
  shiftId   Int     @id @default(autoincrement())
  name      String  @db.VarChar(255)
  startTime String
  endTime   String
  isActive  Boolean @default(true)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  users            ShiftUsers[]
  shiftAssignments ShiftAssignment[]
  shiftTemplates   ShiftTemplate[]
}

model ShiftTemplate {
  id        Int                     @id @default(autoincrement())
  shiftId   Int
  sectionId Int
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  questions ShiftTemplateQuestion[]
  shift     Shift                   @relation(fields: [shiftId], references: [shiftId])
  section   Section                 @relation(fields: [sectionId], references: [id])
}

enum ResponseType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  MULTIPLE_CHOICE
}

model ShiftTemplateQuestion {
  id                    Int           @id @default(autoincrement())
  templateId            Int
  question              String
  responseType          ResponseType
  multipleChoiceOptions String[]
  template              ShiftTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model ShiftUsers {
  shiftId Int
  userId  Int

  shift Shift @relation(fields: [shiftId], references: [shiftId], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([shiftId, userId])
  @@unique([shiftId, userId])
}

enum PlanStatus {
  Draft
  Unpublished
  Published
}

model Plan {
  planId          Int           @id @default(autoincrement())
  planName        String
  planDescription String?
  form            Json
  status          PlanStatus    @default(Draft)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  notes           String?
  planFiles       Planfiles[]
  activePlans     ActivePlans[]
  planAssets      PlanAssets[]
}

model PlanAssets {
  id        Int    @id @default(autoincrement())
  planId    Int
  assetId   Int
  assetName String

  plan  Plan  @relation(fields: [planId], references: [planId])
  asset Asset @relation(fields: [assetId], references: [id])
}

model Planfiles {
  fileId   Int    @id @default(autoincrement())
  fileName String
  filePath String
  type     String
  planId   Int
  plan     Plan   @relation(fields: [planId], references: [planId])
}

model ActivePlans {
  id        Int     @id @default(autoincrement())
  planName  String
  planId    Int
  sectionId Int
  userId    Int?
  plan      Plan    @relation(fields: [planId], references: [planId])
  section   Section @relation(fields: [sectionId], references: [id])
  user      User?   @relation(fields: [userId], references: [userId])
}

model SectionType {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  description String    @db.VarChar(255)
  sections    Section[]
  color       String    @default("#fffff")
}

model Coordinate {
  id        Int   @id @default(autoincrement())
  latitude  Float
  longitude Float
  sectionId Int

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model AssetType {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(255)
  description String  @db.VarChar(255)
  assets      Asset[]
}

model Asset {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(255)
  description  String       @db.VarChar(255)
  assetType    Int
  assetSection Int
  latitude     Float?
  longitude    Float?
  planAssets   PlanAssets[]
  type         AssetType    @relation(fields: [assetType], references: [id])
  section      Section      @relation(fields: [assetSection], references: [id])
}

model RiskMatrix {
  id         Int          @id @default(autoincrement())
  name       String       @db.VarChar(255)
  col        Int
  row        Int
  RiskValues RiskValues[]
}

enum RiskProps {
  Consequence
  Probability
  Exposure
}

model RiskValues {
  id       Int        @id @default(autoincrement())
  type     RiskProps
  name     String
  scale    Float
  matrixId Int
  matrix   RiskMatrix @relation(fields: [matrixId], references: [id])
}

model RiskAssesment {
  id               Int      @id @default(autoincrement())
  activity         String
  sectionId        Int
  section          Section  @relation(fields: [sectionId], references: [id])
  hazard           String
  mechanism        String
  exposedGroup     String
  description      String
  consequence      Float
  exposure         Float
  probability      Float
  riskValue        Float
  riskControlPlan  Json?
  noOfSections     Int?      @default(2)
  noOfSectionsCompleted Int @default(0)
  responses RiskAssessmentResponse[]
}

model RiskAssessmentResponse {
  id               Int      @id @default(autoincrement())
  userId           Int
  formId           Int
  response         Json
  user             User     @relation(fields: [userId], references: [userId])
  form   RiskAssesment @relation(fields: [formId], references: [id])
}

enum MailStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  FAILED
}

enum MailPriority {
  LOW
  MEDIUM
  HIGH
}

model MailTask {
  id           String       @id @default(cuid())
  recipients   String[]
  subject      String
  body         String       @db.Text
  attachments  Json?
  scheduledFor DateTime?
  status       MailStatus   @default(PENDING)
  priority     MailPriority @default(MEDIUM)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  mailLogs MailLog[]
}

model MailLog {
  id           String     @id @default(cuid())
  mailTaskId   String
  recipient    String
  status       MailStatus
  sentAt       DateTime?
  errorMessage String?

  mailTask MailTask @relation(fields: [mailTaskId], references: [id])
}

model hazardActivity {
  id   Int    @id @default(autoincrement())
  name String
}

model hazardHazard {
  id   Int    @id @default(autoincrement())
  name String
}

model hazardMechanism {
  id   Int    @id @default(autoincrement())
  name String
}

model hazardExposedGroup {
  id   Int    @id @default(autoincrement())
  name String
}

model SoftwareIntegration {
  id  Int @id @default(autoincrement())
  
}