// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
  output   = "../../src/utils/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mine {
  mineId             Int       @id @default(autoincrement())
  mineName           String    @db.VarChar(100)
  locationLatitude   Decimal   @db.Decimal(9, 6)
  locationLongitude  Decimal   @db.Decimal(9, 6)
  address            String    @db.VarChar(255)
  ownerId            Int
  mineType           String    @db.VarChar(50)
  productionCapacity Decimal   @db.Decimal(10, 2)
  operationalStatus  String    @db.VarChar(50)
  startDate          DateTime  @db.Date
  endDate            DateTime? @db.Date

  owner         Owner          @relation(fields: [ownerId], references: [ownerId])
  largeSections LargeSection[]

  @@map("mines")
}

model Owner {
  ownerId      Int    @id @default(autoincrement())
  ownerName    String @db.VarChar(100)
  contactName  String @db.VarChar(100)
  contactEmail String @db.VarChar(100)
  contactPhone String @db.VarChar(15)
  mines        Mine[]

  @@map("owners")
}

model LargeSection {
  sectionId   Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  area        Decimal? @db.Decimal(10, 2)
  typeId      Int?
  insiderToId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  mine           Mine?           @relation(fields: [insiderToId], references: [mineId])
  sectionType    SectionType?    @relation(fields: [typeId], references: [typeId])
  mediumSections MediumSection[]
  assets         Asset[]         @relation("LargeSectionAssets")
  Plan           Plan[]

  @@map("large_sections")
}

model MediumSection {
  sectionId   Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  area        Decimal? @db.Decimal(10, 2)
  typeId      Int?
  insiderToId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  largeSection  LargeSection?  @relation(fields: [insiderToId], references: [sectionId])
  sectionType   SectionType?   @relation(fields: [typeId], references: [typeId])
  smallSections SmallSection[]
  assets        Asset[]        @relation("MediumSectionAssets")
  Plan          Plan[]

  @@map("medium_sections")
}

model SmallSection {
  sectionId   Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  area        Decimal? @db.Decimal(10, 2)
  typeId      Int?
  insiderToId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  mediumSection MediumSection? @relation(fields: [insiderToId], references: [sectionId])
  sectionType   SectionType?   @relation(fields: [typeId], references: [typeId])
  microSections MicroSection[]
  assets        Asset[]        @relation("SmallSectionAssets")
  Plan          Plan[]

  @@map("small_sections")
}

model MicroSection {
  sectionId   Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  area        Decimal? @db.Decimal(10, 2)
  typeId      Int?
  insiderToId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  smallSection SmallSection? @relation(fields: [insiderToId], references: [sectionId])
  sectionType  SectionType?  @relation(fields: [typeId], references: [typeId])
  unitSections UnitSection[]
  assets       Asset[]       @relation("MicroSectionAssets")
  Plan         Plan[]

  @@map("micro_sections")
}

model UnitSection {
  unitId      Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  model       String?  @db.VarChar(255)
  typeId      Int?
  insiderToId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  microSection MicroSection? @relation(fields: [insiderToId], references: [sectionId])
  sectionType  SectionType?  @relation(fields: [typeId], references: [typeId])
  assets       Asset[]       @relation("UnitSectionAssets")
  Plan         Plan[]

  @@map("unit_sections")
}

model SectionType {
  typeId      Int      @id @default(autoincrement())
  scaleLevel  Int      @db.Integer
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  largeSections  LargeSection[]
  mediumSections MediumSection[]
  smallSections  SmallSection[]
  microSections  MicroSection[]
  unitSections   UnitSection[]

  sectionItems SectionItem[]

  @@unique([scaleLevel, name])
  @@map("section_types")
}

model SectionItem {
  itemId   Int    @id @default(autoincrement())
  typeId   Int
  itemName String @db.VarChar(255)

  sectionType SectionType @relation(fields: [typeId], references: [typeId])
  assets      Asset[]

  @@map("section_items")
}

model Position {
  positionId       Int      @id @default(autoincrement())
  positionName     String   @db.VarChar(100)
  description      String   @db.Text
  isActive         Boolean  @db.Boolean
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  responsibilities Json
  Users            User[]
}

model Role {
  roleId      Int      @id @default(autoincrement())
  roleName    String   @unique @db.VarChar(100)
  description String?  @db.Text
  permissions Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Users       User[]
}

model Permission {
  permissionId Int     @id @default(autoincrement())
  name         String  @unique @db.VarChar(100)
  category     String  @db.VarChar(50)
  description  String? @db.Text
  isActive     Boolean @default(true)
}

model User {
  userId       Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(100)
  email        String    @unique @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  passwordHash String    @db.VarChar(255)
  salt         String    @db.VarChar(255)
  userRoleId   Int
  userRole     Role      @relation(fields: [userRoleId], references: [roleId])
  positionId   Int?
  Position     Position? @relation(fields: [positionId], references: [positionId])
  isActive     Boolean   @default(true)
  profileImage String?   @db.VarChar(255)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    Int?
  Creator      User?     @relation("UserCreation", fields: [createdBy], references: [userId])
  CreatedUsers User[]    @relation("UserCreation")
}

model Shift {
  shiftId   Int     @id @default(autoincrement())
  name      String  @db.VarChar(255)
  startTime String
  endTime   String
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PlanStatus {
  Draft
  Unpublished
  Published
}

model Plan {
  planId          Int        @id @default(autoincrement())
  planName        String
  planDescription String?
  workAreaType    String?
  workAreaId      Int?
  form            Json
  status          PlanStatus @default(Draft)

  largeSection  LargeSection?  @relation(fields: [workAreaId], references: [sectionId], map: "Plan_largeSection_fkey")
  mediumSection MediumSection? @relation(fields: [workAreaId], references: [sectionId], map: "Plan_mediumSection_fkey")
  smallSection  SmallSection?  @relation(fields: [workAreaId], references: [sectionId], map: "Plan_smallSection_fkey")
  microSection  MicroSection?  @relation(fields: [workAreaId], references: [sectionId], map: "Plan_microSection_fkey")
  unitSection   UnitSection?   @relation(fields: [workAreaId], references: [unitId], map: "Plan_unitSection_fkey")

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  notes     String?
  planFiles Planfiles[]
}

model Planfiles {
  fileId   Int    @id @default(autoincrement())
  fileName String
  filePath String
  type     String
  planId   Int
  plan     Plan   @relation(fields: [planId], references: [planId])
}

model Asset {
  assetId          Int          @id @default(autoincrement())
  assetName        String       @db.VarChar(255)
  assetDescription String       @db.VarChar(255)
  assetModel       String       @db.VarChar(255)
  assetLocation    Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  assetTypeId      Int?
  assetType        SectionItem? @relation(fields: [assetTypeId], references: [itemId])

  largeSection  LargeSection?  @relation("LargeSectionAssets", fields: [assetLocation], references: [sectionId], map: "Asset_LargeSection_Location")
  mediumSection MediumSection? @relation("MediumSectionAssets", fields: [assetLocation], references: [sectionId], map: "Asset_MediumSection_Location")
  smallSection  SmallSection?  @relation("SmallSectionAssets", fields: [assetLocation], references: [sectionId], map: "Asset_SmallSection_Location")
  unitSection   UnitSection?   @relation("UnitSectionAssets", fields: [assetLocation], references: [unitId], map: "Asset_UnitSection_Location")
  microSection  MicroSection?  @relation("MicroSectionAssets", fields: [assetLocation], references: [sectionId], map: "Asset_MicroSection_Location")
}
