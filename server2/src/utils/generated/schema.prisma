// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
  output   = "../../src/utils/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mine {
  mineId             Int       @id @default(autoincrement())
  mineName           String    @db.VarChar(100)
  locationLatitude   Decimal   @db.Decimal(9, 6)
  locationLongitude  Decimal   @db.Decimal(9, 6)
  address            String    @db.VarChar(255)
  ownerId            Int
  mineType           String    @db.VarChar(50)
  productionCapacity Decimal   @db.Decimal(10, 2)
  operationalStatus  String    @db.VarChar(50)
  startDate          DateTime  @db.Date
  endDate            DateTime? @db.Date

  owner Owner @relation(fields: [ownerId], references: [ownerId])

  @@map("mines")
}

model Owner {
  ownerId      Int    @id @default(autoincrement())
  ownerName    String @db.VarChar(100)
  contactName  String @db.VarChar(100)
  contactEmail String @db.VarChar(100)
  contactPhone String @db.VarChar(15)
  mines        Mine[]

  @@map("owners")
}

model Position {
  positionId       Int      @id @default(autoincrement())
  positionName     String   @db.VarChar(100)
  description      String   @db.Text
  isActive         Boolean  @db.Boolean
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  responsibilities Json
  Users            User[]
}

model Role {
  roleId      Int      @id @default(autoincrement())
  roleName    String   @unique @db.VarChar(100)
  description String?  @db.Text
  permissions Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Users       User[]
}

model Permission {
  permissionId Int     @id @default(autoincrement())
  name         String  @unique @db.VarChar(100)
  category     String  @db.VarChar(50)
  description  String? @db.Text
  isActive     Boolean @default(true)
}

model User {
  userId       Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(100)
  email        String    @unique @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  passwordHash String    @db.VarChar(255)
  salt         String    @db.VarChar(255)
  userRoleId   Int
  userRole     Role      @relation(fields: [userRoleId], references: [roleId])
  positionId   Int?
  Position     Position? @relation(fields: [positionId], references: [positionId])
  isActive     Boolean   @default(true)
  profileImage String?   @db.VarChar(255)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    Int?
  Creator      User?     @relation("UserCreation", fields: [createdBy], references: [userId])
  CreatedUsers User[]    @relation("UserCreation")
}

model Shift {
  shiftId   Int     @id @default(autoincrement())
  name      String  @db.VarChar(255)
  startTime String
  endTime   String
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PlanStatus {
  Draft
  Unpublished
  Published
}

model Plan {
  planId          Int           @id @default(autoincrement())
  planName        String
  planDescription String?
  workAreaType    String?
  workAreaId      Int?
  form            Json
  status          PlanStatus    @default(Draft)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  notes           String?
  planFiles       Planfiles[]
  activePlans     ActivePlans[]
}

model Planfiles {
  fileId   Int    @id @default(autoincrement())
  fileName String
  filePath String
  type     String
  planId   Int
  plan     Plan   @relation(fields: [planId], references: [planId])
}

model ActivePlans {
  id        Int    @id @default(autoincrement())
  planName  String
  planId    Int
  sectionId Int

  plan    Plan    @relation(fields: [planId], references: [planId])
  section Section @relation(fields: [sectionId], references: [id])
}

model SectionType {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  description String    @db.VarChar(255)
  sections    Section[]
}

model Section {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(255)
  sectionType Int
  area        Int?

  type        SectionType   @relation(fields: [sectionType], references: [id])
  assets      Asset[]
  coordinates Coordinate[]
  activePlans ActivePlans[]
}

model AssetType {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(255)
  description String  @db.VarChar(255)
  assets      Asset[]
}

model Asset {
  id           Int    @id @default(autoincrement())
  name         String @db.VarChar(255)
  description  String @db.VarChar(255)
  assetType    Int
  assetSection Int

  type    AssetType @relation(fields: [assetType], references: [id])
  section Section   @relation(fields: [assetSection], references: [id])
}

model Coordinate {
  id        Int   @id @default(autoincrement())
  latitude  Float
  longitude Float
  sectionId Int

  section Section @relation(fields: [sectionId], references: [id])
}
